{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wilkes",
  "identifier": "app.wilkes",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node ../scripts/prepare-sidecar.mjs --release && npm --prefix ../ui run dev",
    "beforeBuildCommand": "node ../scripts/prepare-sidecar.mjs --release && npm --prefix ../ui run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["sidecars/wilkes-rust-worker"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/pdf"
      },
      {
        "ext": ["txt", "log"],
        "name": "Text Document",
        "description": "UTF-8 text document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/plain"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML Document",
        "description": "HTML document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/html"
      },
      {
        "ext": ["csv"],
        "name": "CSV Document",
        "description": "Comma-separated values",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/csv"
      },
      {
        "ext": ["json", "jsonl"],
        "name": "JSON Document",
        "description": "JSON document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/json"
      },
      {
        "ext": ["xml"],
        "name": "XML Document",
        "description": "XML document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/xml"
      }
    ],
    "resources": {
      "../worker/wilkes_python_worker": "wilkes_python_worker",
      "../worker/requirements.txt": "requirements.txt"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Wilkes",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 200,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}
